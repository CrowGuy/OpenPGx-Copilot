{
  "dataset": "nhgri-ebi-gwas-catalog",
  "provider": "NHGRI-EBI GWAS Catalog",
  "output_root": "/srv/openpgx/raw/gwas_catalog",
  "pipeline_version": "1.0.0",
  "snapshot_id_template": "r{release_date}",
  "allowed_hosts": [
    "www.ebi.ac.uk"
  ],
  "allow_http": false,
  "request_timeout_seconds": 60,
  "max_attempts": 3,
  "max_concurrent_requests": 4,
  "retry_base_seconds": 2.0,
  "raw_snapshot_options": {
    "request_timeout_seconds": 120,
    "max_download_attempts": 4,
    "retry_base_seconds": 2.0
  },
  "endpoints": [
    {
      "role": "published_associations",
      "url": "https://www.ebi.ac.uk/gwas/api/search/downloads/associations/v1.0.2?split=false",
      "filename_pattern": "^gwas_catalog_v(?P<format>[0-9.]+)-associations_e(?P<ensembl>[0-9]+)_r(?P<release_date>[0-9]{4}-[0-9]{2}-[0-9]{2})_full\\.zip$",
      "format_version": "v1.0.2",
      "expected_ensembl": "e116",
      "load_policy": "load_to_curated",
      "expected_column_count": 38,
      "expected_header": [
        "DATE ADDED TO CATALOG",
        "PUBMEDID",
        "FIRST AUTHOR",
        "DATE",
        "JOURNAL",
        "LINK",
        "STUDY",
        "DISEASE/TRAIT",
        "INITIAL SAMPLE SIZE",
        "REPLICATION SAMPLE SIZE",
        "REGION",
        "CHR_ID",
        "CHR_POS",
        "REPORTED GENE(S)",
        "MAPPED_GENE",
        "UPSTREAM_GENE_ID",
        "DOWNSTREAM_GENE_ID",
        "SNP_GENE_IDS",
        "UPSTREAM_GENE_DISTANCE",
        "DOWNSTREAM_GENE_DISTANCE",
        "STRONGEST SNP-RISK ALLELE",
        "SNPS",
        "MERGED",
        "SNP_ID_CURRENT",
        "CONTEXT",
        "INTERGENIC",
        "RISK ALLELE FREQUENCY",
        "P-VALUE",
        "PVALUE_MLOG",
        "P-VALUE (TEXT)",
        "OR or BETA",
        "95% CI (TEXT)",
        "PLATFORM [SNPS PASSING QC]",
        "CNV",
        "MAPPED_TRAIT",
        "MAPPED_TRAIT_URI",
        "STUDY ACCESSION",
        "GENOTYPING TECHNOLOGY"
      ],
      "minimum_data_rows": 950000,
      "required": true,
      "archive": {
        "type": "zip",
        "member": "gwas-catalog-download-associations-alt-full.tsv"
      }
    },
    {
      "role": "published_studies",
      "url": "https://www.ebi.ac.uk/gwas/api/search/downloads/studies/v1.0.3.1",
      "filename_pattern": "^gwas-catalog-v(?P<format>[0-9.]+)-studies-r(?P<release_date>[0-9]{4}-[0-9]{2}-[0-9]{2})\\.tsv$",
      "format_version": "v1.0.3.1",
      "load_policy": "load_to_curated",
      "expected_column_count": 25,
      "expected_header": [
        "DATE ADDED TO CATALOG",
        "PUBMED ID",
        "FIRST AUTHOR",
        "DATE",
        "JOURNAL",
        "LINK",
        "STUDY",
        "DISEASE/TRAIT",
        "INITIAL SAMPLE SIZE",
        "REPLICATION SAMPLE SIZE",
        "PLATFORM [SNPS PASSING QC]",
        "ASSOCIATION COUNT",
        "MAPPED_TRAIT",
        "MAPPED_TRAIT_URI",
        "STUDY ACCESSION",
        "GENOTYPING TECHNOLOGY",
        "SUBMISSION DATE",
        "STATISTICAL MODEL",
        "BACKGROUND TRAIT",
        "MAPPED BACKGROUND TRAIT",
        "MAPPED BACKGROUND TRAIT URI",
        "COHORT",
        "FULL SUMMARY STATISTICS",
        "SUMMARY STATS LOCATION",
        "GXE"
      ],
      "minimum_data_rows": 180000,
      "required": true
    },
    {
      "role": "published_ancestries",
      "url": "https://www.ebi.ac.uk/gwas/api/search/downloads/ancestries/v1.0.3.1",
      "filename_pattern": "^gwas-catalog-v(?P<format>[0-9.]+)-ancestries-r(?P<release_date>[0-9]{4}-[0-9]{2}-[0-9]{2})\\.tsv$",
      "format_version": "v1.0.3.1",
      "load_policy": "load_to_curated",
      "expected_column_count": 17,
      "expected_header": [
        "STUDY ACCESSION",
        "PUBMED ID",
        "FIRST AUTHOR",
        "DATE",
        "INITIAL SAMPLE DESCRIPTION",
        "REPLICATION SAMPLE DESCRIPTION",
        "STAGE",
        "NUMBER OF INDIVIDUALS",
        "BROAD ANCESTRAL CATEGORY",
        "COUNTRY OF ORIGIN",
        "COUNTRY OF RECRUITMENT",
        "ADDITIONAL ANCESTRY DESCRIPTION",
        "ANCESTRY DESCRIPTOR",
        "FOUNDER/GENETICALLY ISOLATED POPULATION",
        "NUMBER OF CASES",
        "NUMBER OF CONTROLS",
        "SAMPLE DESCRIPTION"
      ],
      "minimum_data_rows": 235000,
      "required": true
    },
    {
      "role": "trait_mappings",
      "url": "https://www.ebi.ac.uk/gwas/api/search/downloads/trait_mappings",
      "filename_pattern": "^gwas_catalog_trait-mappings_r(?P<release_date>[0-9]{4}-[0-9]{2}-[0-9]{2})\\.tsv$",
      "load_policy": "load_to_curated",
      "expected_column_count": 5,
      "expected_header": [
        "Disease trait",
        "EFO term",
        "EFO URI",
        "Parent term",
        "Parent URI"
      ],
      "minimum_data_rows": 88000,
      "required": true
    },
    {
      "role": "unpublished_studies",
      "url": "https://www.ebi.ac.uk/gwas/api/search/downloads/unpublished_studies/v1.0.3.1",
      "filename_pattern": "^gwas-catalog-v(?P<format>[0-9.]+)-unpublished-studies-r(?P<release_date>[0-9]{4}-[0-9]{2}-[0-9]{2})\\.tsv$",
      "format_version": "v1.0.3.1",
      "load_policy": "raw_only",
      "expected_column_count": 24,
      "expected_header": [
        "DATE ADDED TO CATALOG",
        "PUBMED ID",
        "FIRST AUTHOR",
        "DATE",
        "JOURNAL",
        "LINK",
        "STUDY",
        "DISEASE/TRAIT",
        "INITIAL SAMPLE SIZE",
        "REPLICATION SAMPLE SIZE",
        "PLATFORM [SNPS PASSING QC]",
        "ASSOCIATION COUNT",
        "MAPPED_TRAIT",
        "MAPPED_TRAIT_URI",
        "STUDY ACCESSION",
        "GENOTYPING TECHNOLOGY",
        "SUBMISSION DATE",
        "STATISTICAL MODEL",
        "BACKGROUND TRAIT",
        "MAPPED BACKGROUND TRAIT",
        "MAPPED BACKGROUND TRAIT URI",
        "COHORT",
        "FULL SUMMARY STATISTICS",
        "SUMMARY STATS LOCATION"
      ],
      "minimum_data_rows": 11000,
      "required": true
    },
    {
      "role": "unpublished_ancestries",
      "url": "https://www.ebi.ac.uk/gwas/api/search/downloads/unpublished_ancestries/v1.0.3.1",
      "filename_pattern": "^gwas-catalog-v(?P<format>[0-9.]+)-unpublished-ancestries-r(?P<release_date>[0-9]{4}-[0-9]{2}-[0-9]{2})\\.tsv$",
      "format_version": "v1.0.3.1",
      "load_policy": "raw_only",
      "expected_column_count": 17,
      "expected_header": [
        "STUDY ACCESSION",
        "PUBMED ID",
        "FIRST AUTHOR",
        "DATE",
        "INITIAL SAMPLE DESCRIPTION",
        "REPLICATION SAMPLE DESCRIPTION",
        "STAGE",
        "NUMBER OF INDIVIDUALS",
        "BROAD ANCESTRAL CATEGORY",
        "COUNTRY OF ORIGIN",
        "COUNTRY OF RECRUITMENT",
        "ADDITIONAL ANCESTRY DESCRIPTION",
        "ANCESTRY DESCRIPTOR",
        "FOUNDER/GENETICALLY ISOLATED POPULATION",
        "NUMBER OF CASES",
        "NUMBER OF CONTROLS",
        "SAMPLE DESCRIPTION"
      ],
      "minimum_data_rows": 24000,
      "required": true
    }
  ]
}