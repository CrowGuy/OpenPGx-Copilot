          "note": "kept verbatim; per-variant allele in association_snp.risk_allele"
        },
        {
          "source_column": "SNPS",
          "curated_column": "snps",
          "curated_type": "text",
          "nullable": false,
          "required": true,
          "null_tokens": [],
          "split_rule": {
            "target_table": "association_snp",
            "combination_rules": [
              {
                "separator": " x ",
                "snp_combination": "interaction"
              },
              {
                "separator": ";",
                "snp_combination": "haplotype"
              },
              {
                "separator": "/",
                "snp_combination": "alternative"
              },
              {
                "separator": ",",
                "snp_combination": "list"
              }
            ],
            "default_snp_combination": "single",
            "token_trim": true,
            "variant_kind_rules": [
              {
                "variant_kind": "rsid",
                "pattern": "^rs(\\d+)$"
              },
              {
                "variant_kind": "chr_pos",
                "pattern": "(?i)^(?:chr)?([0-9]{1,2}|X|Y|MT):(\\d+)$"
              }
            ],
            "default_variant_kind": "other",
            "aligned_columns": [
              "CHR_ID",
              "CHR_POS",
              "STRONGEST SNP-RISK ALLELE"
            ],
            "alignment": "positional_only_if_token_counts_equal",
            "on_misaligned": "aligned_values_null_and_flag",
            "on_empty_token": "drop_token_and_flag_misaligned",
            "chr_pos_kind_takes_locus_from_token": true,
            "risk_allele": "text after the last '-' of the aligned token, verbatim; '?' means the source did not specify the risk allele"
          },
          "keep_text": null,
          "on_parse_failure": "reject_row",
          "addresses": [
            "LENGTH_OUTLIER",
            "DUPLICATE_MULTIVALUE_TOKEN"
          ],
          "note": "required = non-empty; any Variant Token form accepted"
        },
