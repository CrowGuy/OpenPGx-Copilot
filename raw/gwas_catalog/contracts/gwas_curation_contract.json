{
  "contract": "gwas-curation-contract",
  "dataset": "nhgri-ebi-gwas-catalog",
  "version": 1,
  "genome_build": "GRCh38",
  "genome_build_applies_to": [
    "published_associations.CHR_POS",
    "association_snp.pos"
  ],
  "description": "CurationContract: column-level rules turning load_to_curated files of a RawSnapshot into a Release. Generic across Source Releases sharing these format_versions.",
  "global_rules": {
    "trim": "leading/trailing whitespace",
    "empty_after_trim": "null",
    "unicode_normalization": null,
    "case_folding": null,
    "null_tokens_apply_only_where_listed": true,
    "text_columns_without_null_tokens_are_stored_verbatim": true,
    "text_columns_note": "tokens like NR/NA in text columns without null_tokens are source values, not NULL; IS NOT NULL does not mean reported",
    "keep_text_suffix": "_text",
    "on_parse_failure_values": {
      "reject_row": "row becomes a Rejected Row (Required Field)",
      "null": "value stored as NULL; original kept in *_text when keep_text"
    },
    "addresses_source": "Review Queue issue codes in the profile report"
  },
  "type_vocabulary": {
    "text": "verbatim string",
    "integer": "base-10 integer",
    "decimal": "finite double precision; Infinity/NaN are parse failures",
    "date": "ISO YYYY-MM-DD",
    "flag_01": "'0'/'1' to boolean",
    "yes_no": "'yes'/'no' (case-insensitive) to boolean",
    "p_value": "'<mantissa>E-<exponent>' to p_value_mantissa numeric + p_value_exponent integer; never a double (ADR-0009)"
  },
